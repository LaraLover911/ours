{
  "name": "ours",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "photos": "node scripts/build-photos.mjs",
    "predev": "node scripts/build-photos.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-photos.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "node scripts/build-photos.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:setup-sql": "node scripts/build-setup-sql.mjs",
    "db:types": "supabase gen types typescript --local > src/types/database.tmp && mv src/types/database.tmp src/types/database.ts",
    "test:db": "node scripts/test-db.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings scripts/test-sync.mjs && node scripts/test-integrations.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.28",
    "lucide-react": "^1.80.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jiti": "^2.7.0",
    "sharp": "^0.35.5",
    "supabase": "^3.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
