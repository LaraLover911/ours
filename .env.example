# ours. — copy this file to .env.local and fill in your Supabase project values.
# Supabase Dashboard → Project Settings → API Keys / Data API.
# Only the PUBLIC (publishable / anon) key belongs here. NEVER put the
# service_role / secret key into this app or into GitHub.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional: the public URL of your deployment (used for auth email links).
# Locally: http://localhost:3000 — on Vercel: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SERVER-ONLY secrets (no NEXT_PUBLIC_ prefix). Set them in Vercel → Settings →
# Environment Variables. They never reach the browser or GitHub.
# ---------------------------------------------------------------------------

# Calls: TURN relay for networks without a direct path (mobile ↔ mobile, firewalls).
# Option A – Cloudflare Realtime TURN (dash.cloudflare.com → Realtime → TURN):
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Option B – any TURN server:
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Integrations: 32 random bytes that encrypt OAuth tokens and webhook URLs before
# they are stored. Generate with:  openssl rand -hex 32
# Changing it later disconnects all integrations (old tokens can't be decrypted).
INTEGRATIONS_ENCRYPTION_KEY=

# Spotify (developer.spotify.com/dashboard). Redirect URI:
#   https://YOUR-APP/api/integrations/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google Calendar, read-only (console.cloud.google.com → APIs & Services). Redirect URI:
#   https://YOUR-APP/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional search providers (each one works on its own; leave empty to switch it off).
YOUTUBE_API_KEY=
GIPHY_API_KEY=
TENOR_API_KEY=
UNSPLASH_ACCESS_KEY=
# TMDB: the "API Read Access Token" (v4), not the short v3 key.
TMDB_API_TOKEN=

# Open-Meteo (weather) and OpenStreetMap need no keys. Discord uses a webhook URL
# that each of you pastes on the Integrations page (stored encrypted).
