# ours. — copy this file to .env.local and fill in your Supabase project values.
# Supabase Dashboard → Project Settings → API Keys / Data API.
# Only the PUBLIC (publishable / anon) key belongs here. NEVER put the
# service_role / secret key into this app or into GitHub.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional: the public URL of your deployment (used for auth email links).
# Locally: http://localhost:3000 — on Vercel: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
